# ============================================================
# SAKLOLO 161 — Mobile env
# ============================================================
# PRODUCTION (Render) — use this for the distributed APK build:
EXPO_PUBLIC_API_BASE_URL=https://saklolo161-backend.onrender.com

# LOCAL DEV — point at your machine's LAN IP while iterating,
# then flip back to Render before building the APK you ship.
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:5000
# (must be the LAN IP, not "localhost" — a phone is a different device)

# Mapbox public token (loads map tiles on the Location / Tracker screens).
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_public_mapbox_token_here

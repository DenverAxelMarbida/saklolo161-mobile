{
  "expo": {
    "name": "Saklolo 161",
    "slug": "saklolo161-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mdrrmo.saklolo161",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111A3A"
      },
      "package": "com.mdrrmo.saklolo161",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-location",
      "@rnmapbox/maps",
      "expo-status-bar",
      "./plugins/withCmakeVersion",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#111A3A"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7a2bda9e-9667-40f3-9656-b772aa5e14ec"
      }
    },
    "owner": "denver-axel"
  }
}
